    <string name="profile_versions">पद्धति %1$s · निजता %2$s · शर्तें %3$s</string>
    <string name="profile_methodology">AAHAR अभी कोई कुल स्कोर नहीं दिखाता। विशेषज्ञ-समीक्षित पद्धति प्रकाशित होने तक स्कोर बंद रहेंगे। पोषक स्तर सांकेतिक सीमाओं पर आधारित हैं जिनकी विशेषज्ञ समीक्षा लंबित है।</string>
    <string name="profile_privacy_summary">खाते की ज़रूरत नहीं। आपका इतिहास इसी फ़ोन पर रहता है। आपकी भेजी उत्पाद फ़ोटो कुछ भी प्रकाशित होने से पहले लोगों द्वारा जाँची जाती हैं।</string>
    <string name="profile_disclaimer">AAHAR बताता है कि फ़ूड लेबल पर क्या घोषित है। यह चिकित्सा या आहार सलाह नहीं है और FSSAI या GS1 द्वारा समर्थित नहीं है।</string>
