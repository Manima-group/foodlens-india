<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only (SPEC §10.1): cleartext to a local API. A physical phone may use 127.0.0.1 (adb reverse) or the
  laptop's LAN IP, which cannot be listed in advance, so debug allows cleartext generally. Release and staging use
  src/main/res/xml/network_security_config.xml, which forbids it.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
