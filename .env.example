# Dummy values only. Copy to .env (gitignored) and fill locally.
APP_ENV=development
POSTGRES_PASSWORD=devonly
DATABASE_URL=postgresql+asyncpg://postgres:devonly@127.0.0.1:5432/foodlens
# Base URL the phone uses for photo uploads. With `adb reverse tcp:8000 tcp:8000`, keep localhost.
PUBLIC_BASE_URL=http://localhost:8000
UPLOAD_DIR=var/uploads
